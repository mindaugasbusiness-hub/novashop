{
  "name": "Cline worker demo (n8n -> Cline CLI)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 6
            }
          ]
        }
      },
      "id": "0f1a1c1e-0001-4000-8000-000000000001",
      "name": "Kas 6 val.",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [-440, 0]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "a1",
              "name": "prompt",
              "value": "Patikrink repozitorijos testus, sutvarkyk tai, kas krenta, ir trumpai aprašyk, ką pakeitei.",
              "type": "string"
            },
            {
              "id": "a2",
              "name": "cwd",
              "value": "projektas",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "0f1a1c1e-0002-4000-8000-000000000002",
      "name": "Užduotis",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [-220, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://cline-worker:7070/run",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-worker-token",
              "value": "={{ $env.WORKER_TOKEN }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ prompt: $json.prompt, cwd: $json.cwd, timeout: 1800 }) }}",
        "options": {
          "timeout": 1900000,
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      },
      "id": "0f1a1c1e-0003-4000-8000-000000000003",
      "name": "Cline worker",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [20, 0]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.ok === true }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "0f1a1c1e-0004-4000-8000-000000000004",
      "name": "Ar pavyko?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [260, 0]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "b1",
              "name": "rezultatas",
              "value": "={{ $json.text }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "0f1a1c1e-0005-4000-8000-000000000005",
      "name": "OK: ataskaita",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [520, -100]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "c1",
              "name": "klaida",
              "value": "={{ $json.error }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "0f1a1c1e-0006-4000-8000-000000000006",
      "name": "Klaida: alertas",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [520, 100]
    }
  ],
  "connections": {
    "Kas 6 val.": {
      "main": [
        [
          {
            "node": "Užduotis",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Užduotis": {
      "main": [
        [
          {
            "node": "Cline worker",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Cline worker": {
      "main": [
        [
          {
            "node": "Ar pavyko?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Ar pavyko?": {
      "main": [
        [
          {
            "node": "OK: ataskaita",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Klaida: alertas",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {}
}
