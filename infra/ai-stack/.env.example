# Nusikopijuok į .env ir užpildyk. .env NEcommitink.

# --- n8n ---
GENERIC_TIMEZONE=Europe/Vilnius
# Jei atsiduri už reverse proxy / tunelio – įrašyk tikrą adresą:
# WEBHOOK_URL=https://n8n.tavodomenas.lt/

# --- cline-worker ---
# Sugeneruok: openssl rand -hex 32
WORKER_TOKEN=pakeisk_mane

# Provider id ir model id: pažiūrėk `cline auth` / `cline` -> /model sąraše savo versijoje.
# Pavyzdžiai (tikėkis, kad pavadinimai kinta):
#   CLINE_PROVIDER=openrouter   CLINE_MODEL=deepseek/deepseek-chat-v3.1:free
#   CLINE_PROVIDER=gemini       CLINE_MODEL=gemini-2.5-flash
#   CLINE_PROVIDER=anthropic    CLINE_MODEL=claude-sonnet-4-6
CLINE_PROVIDER=
CLINE_MODEL=

# Rakštas tam pačiam provider'iui (OpenRouter / Google AI Studio / Anthropic ...)
CLINE_API_KEY=

# Kiek sekundžių vienai užduočiai (worker'yje ir n8n node timeout'as turi sutapti)
TASK_TIMEOUT_SECONDS=1800

# Kiek iš eilės klaidų agentui leidžiama prieš nutraukiant
CLINE_RETRIES=3
